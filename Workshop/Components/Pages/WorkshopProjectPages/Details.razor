@page "/workshopprojects/details"
@using Microsoft.EntityFrameworkCore
@using Workshop.Models
@inject IDbContextFactory<Workshop.Data.WorkshopContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>WorkshopProject</h2>
    <hr />
    @if (workshopproject is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">ProductName</dt>
            <dd class="col-sm-10">@workshopproject.ProductName</dd>
            <dt class="col-sm-2">MaterialsSummary</dt>
            <dd class="col-sm-10">@workshopproject.MaterialsSummary</dd>
            <dt class="col-sm-2">Notes</dt>
            <dd class="col-sm-10">@workshopproject.Notes</dd>
            <dt class="col-sm-2">MaterialCost</dt>
            <dd class="col-sm-10">@workshopproject.MaterialCost</dd>
            <dt class="col-sm-2">SalePrice</dt>
            <dd class="col-sm-10">@workshopproject.SalePrice</dd>
            <dt class="col-sm-2">StartedOn</dt>
            <dd class="col-sm-10">@workshopproject.StartedOn</dd>
            <dt class="col-sm-2">DeadlineOn</dt>
            <dd class="col-sm-10">@workshopproject.DeadlineOn</dd>
            <dt class="col-sm-2">CompletedOn</dt>
            <dd class="col-sm-10">@workshopproject.CompletedOn</dd>
            <dt class="col-sm-2">Stage</dt>
            <dd class="col-sm-10">@workshopproject.Stage</dd>
        </dl>
        <div>
            <a href="@($"/workshopprojects/edit?id={workshopproject.Id}")">Edit</a> |
            <a href="@($"/workshopprojects")">Back to List</a>
        </div>
    }
</div>

@code {
    private WorkshopProject? workshopproject;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        workshopproject = await context.WorkshopProjects.FirstOrDefaultAsync(m => m.Id == Id);

        if (workshopproject is null)
        {
            NavigationManager.NotFound();
        }
    }
}
